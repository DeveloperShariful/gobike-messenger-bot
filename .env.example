# ---- Server ----
PORT=3000

# ---- Meta (Facebook/Instagram) ----
# Any random string you invent yourself. You'll type this exact same value
# into the Meta App Dashboard webhook setup screen.
META_VERIFY_TOKEN=choose_any_random_string_here

# Meta App Dashboard -> App Settings -> Basic -> App Secret
META_APP_SECRET=

# Meta App Dashboard -> Messenger -> Settings -> Access Tokens
# (Generate a token for your GoBike Page. This same token is used to send
# both Messenger AND Instagram DM replies, because your Instagram
# professional account is linked to your Facebook Page.)
META_PAGE_ACCESS_TOKEN=

# Graph API version to call (keep updated occasionally, see Meta changelog)
META_GRAPH_API_VERSION=v21.0

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=

# Only needed if your API key is "workspace-linked" / "identity-linked"
# (the API returns "anthropic-workspace-id is required" without it). Find it
# in console.anthropic.com -> Settings -> Workspaces (looks like wrkspc_...).
# Leave blank for a normal org / Default-workspace key.
ANTHROPIC_WORKSPACE_ID=

# Check https://docs.claude.com/en/docs/about-claude/models for the current
# recommended model ID at the time you deploy this — model names get
# retired/replaced over time. claude-sonnet-5 balances speed/cost/quality for
# support chat; use claude-opus-5 for the strongest replies at higher cost.
CLAUDE_MODEL=claude-sonnet-5

# ---- Bot's own database (conversation history, handoff queue, settings) ----
# This is the bot's OWN small database — NOT the store database. Run
# sql/schema.sql against it once. Any Postgres works (Render, Neon, Supabase).
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- my-shop store API (live product + order data) ----
# The bot reads products, prices, stock and order status from the my-shop
# store's read-only internal API. Set BOT_API_KEY to the SAME value you set
# in the my-shop project's environment.
SHOP_API_BASE_URL=https://gobike.au
BOT_API_KEY=
# Optional: request timeout in ms (default 8000)
# SHOP_API_TIMEOUT_MS=8000

# ---- Dashboard sign-in ----
# The admin dashboard at /dashboard is disabled until both of these are set.
# Sign in at /login (styled page, session cookie lasts 12 hours).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Optional: secret used to sign the session cookie. If unset, it's derived
# from DASHBOARD_PASSWORD (changing the password then logs everyone out).
# SESSION_SECRET=

# ---- Human handoff (optional) ----
# Email shown to customers when the bot can't help and a human is needed.
SUPPORT_EMAIL=gobike@gobike.au
SUPPORT_PHONE=+61 426 067 277
# After the bot hands a thread to a human (or a team member replies from the
# Business Suite inbox), the bot stays quiet on that one thread for this many
# minutes, then resumes automatically. Default 30.
# BOT_RESUME_AFTER_MINUTES=30
